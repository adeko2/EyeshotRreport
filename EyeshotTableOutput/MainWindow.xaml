<Window x:Class="EyeshotTableOutput.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeshotTableOutput"
        mc:Ignorable="d"
xmlns:ddes="http://schemas.devdept.com/winfx/2008/xaml/control"
Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="tabControl" Grid.Column="0">
            <TabItem Header="Design">
                <ddes:Design x:Name="design1">
                    <ddes:Design.Viewports>
                        <ddes:Viewport>
                            <ddes:Viewport.OriginSymbols>
                                <ddes:OriginSymbol Lighting="False" />
                            </ddes:Viewport.OriginSymbols>
                            <ddes:Viewport.CoordinateSystemIcon>
                                <ddes:CoordinateSystemIcon Lighting="False" />
                            </ddes:Viewport.CoordinateSystemIcon>
                            <ddes:Viewport.ViewCubeIcon>
                                <ddes:ViewCubeIcon Lighting="False" />
                            </ddes:Viewport.ViewCubeIcon>
                            <ddes:Viewport.Background>
                                <ddes:BackgroundSettings StyleMode="Solid" TopColor="WhiteSmoke" />
                            </ddes:Viewport.Background>
                            <ddes:Viewport.Grids>
                                <ddes:Grid Step="10" Lighting="False" />
                            </ddes:Viewport.Grids>
                            <ddes:Viewport.ToolBars>
                                <ddes:ToolBar>
                                    <ddes:ToolBar.Buttons>
                                        <ddes:HomeToolBarButton />
                                        <ddes:MagnifyingGlassToolBarButton />
                                        <ddes:ZoomWindowToolBarButton />
                                        <ddes:ZoomToolBarButton />
                                        <ddes:PanToolBarButton />
                                        <ddes:RotateToolBarButton />
                                        <ddes:ZoomFitToolBarButton />
                                    </ddes:ToolBar.Buttons>
                                </ddes:ToolBar>
                            </ddes:Viewport.ToolBars>
                        </ddes:Viewport>
                    </ddes:Design.Viewports>
                </ddes:Design>
            </TabItem>
            <TabItem Header="Drawing" Selector.IsSelected="True">
                <ddes:Drawing x:Name="drawing1"/>
            </TabItem>
        </TabControl>
        <ScrollViewer Grid.Column="1">
            <StackPanel>
                <Label Content="Controls"/>
                <Button x:Name="btnDrawTable" Content="Draw Table" Click="ButtonDrawTable_Click" Margin="4"/>
                <Button x:Name="btnPrintPreview" Content="Print Preview" Click="btnPrintPreview_Click" Margin="4"/>
                <Button x:Name="btnPrint" Content="Print" Click="btnPrint_Click" Margin="4"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
